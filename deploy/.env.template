# Copy to .secrets/swarm.env and chmod 600.
# This file is shell-sourced by scripts/deploy-swarm.sh.

DOMAIN=example.com
DEPLOY_NODE=wawo01
STACK_NAME=edge

# Published agent image. Pin to a version tag for production; use :latest only for disposable test stacks.
AGENT_IMAGE=ghcr.io/loongel/cf-tunnel-subscription-manager:v0.1.3

# Cloudflare Tunnel token for fixed tunnel. Leave empty to only run quick tunnels.
TUNNEL_TOKEN=

# Space or comma separated quick tunnel targets.
QUICK_TUNNELS="http://s1:2095 http://s2:2096 http://s3:80"

# Cloudflare edge IP version: auto, 4, or 6. Use auto for Docker Swarm overlay networks unless IPv6 is known to work in containers.
EDGE_IP_VERSION=auto

# Worker control plane.
WORKER_BASE_URL=https://cf-tunnel-control-plane.example.workers.dev
AGENT_TOKEN=

# Optional tuning. Defaults match the values below.
FIXED_METRICS_PORT_BASE=2000
QUICK_METRICS_PORT_BASE=2100
HEARTBEAT_INTERVAL=30s
COMMAND_POLL_INTERVAL=20s
RESTART_COOLDOWN_SECONDS=610
QUICK_START_SPACING=20s
